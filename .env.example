# Copy to `.env` for local tooling (never commit `.env`).
# Key names mirror CI `--dart-define` usage in workflows.

# -----------------------------------------------------------------------------
# Local Supabase (from `supabase start` → `supabase status -o env`)
# -----------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_DB_URL=
API_URL=http://127.0.0.1:54321
DB_URL=

# -----------------------------------------------------------------------------
# Clients (Flutter shell, integration tests): publishable / anon JWT only.
# -----------------------------------------------------------------------------
AUTOLIFE_SUPABASE_ANON_KEY=YOUR_LOCAL_ANON_JWT_HERE
SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Servers / CLI / CI diagnostics only — NEVER ship in production mobile builds.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Flutter auth / deep-links
# -----------------------------------------------------------------------------
AUTOLIFE_OAUTH_REDIRECT=autolife://login-callback

# -----------------------------------------------------------------------------
# Hosted-only (Dashboard `supabase secrets` or Vault management)
# -----------------------------------------------------------------------------
# EDGE_WEBHOOK_HMAC_ROTATE_HERE=
# GOOGLE_WEB_CLIENT_SECRET=
# APPLE_TEAM_ID=
