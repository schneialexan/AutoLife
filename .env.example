# Copy to .env and fill in values from `supabase start` (local) or the Supabase dashboard (hosted).

# --- Flutter shell / client (public anon key) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# --- Direct Postgres (optional: advisory locks per docs/event-bus-contract.md) ---
SUPABASE_DB_DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Optional: Supabase Studio AI features (see supabase/config.toml) ---
OPENAI_API_KEY=

# --- Referenced from supabase/config.toml for hosted OAuth/SMS (secrets only on host/env) ---
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# --- Experimental S3 placeholders in config.toml (unused locally unless enabled) ---
S3_HOST=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
