# AutoAssets sync configuration (optional).
#
# Sync is OFF by default — with these unset the app runs fully local-only.
# These values are passed at build/run time via --dart-define (NOT loaded from a
# committed .env), so no secrets live in the repo:
#
#   flutter run \
#     --dart-define=SUPABASE_URL=$SUPABASE_URL \
#     --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
#
# Only the public anon/publishable key belongs here. The service-role key is
# NEVER shipped to the client — it lives only in Supabase Edge Function secrets
# (see platform/supabase/README.md).

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
